# --- Never publish: local environment ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Never publish: user data ---
# storage/ holds the uploaded PDFs and storage/database.db (document metadata).
# It is runtime data: regenerated by the app, and the documents are private.
# Losing it once already cost five user documents, so keep it out of git.
storage/

# A stray PDF dropped in the project root is almost always user data. Scoped to
# the root on purpose, so tests/fixtures/*.pdf can still be committed.
/*.pdf

# PyMuPDF stages each revision as `.vN.tmp.pdf` before replace() renames it.
.*.tmp.pdf

# --- Secrets / local config ---
.env
.env.*
*.pem
*.key

# --- Editor / OS noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
*.log